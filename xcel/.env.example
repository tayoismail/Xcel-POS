# Xcel POS environment variables
# Copy to .env and fill in real values. Never commit .env

# PostgreSQL connection string (Prisma) — Supabase session pooler, port 6543
DATABASE_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection for Prisma CLI (migrations / db push) — port 5432
DIRECT_URL="postgresql://postgres:password@db.<project-ref>.supabase.co:5432/postgres"

# Supabase (Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
